---
import Full from '../layouts/Full.astro';
import octicons from '@primer/octicons';

const appUrl = 'https://app.gdam.dev';
const repo = 'https://github.com/aviorstudio/gdam';
const actions = 'https://github.com/aviorstudio/gdam-actions';
const icon = (name: keyof typeof octicons, size = 16) => octicons[name].toSVG({ width: size, height: size });

// Every command the CLI has, taken from printUsage in main.go. Listing all of
// them rather than the three that make a good demo is the point: this is the
// whole surface, and it is small enough to print.
const commands = [
	{ cmd: 'gdam init', does: 'Write gdam.json in this Godot project' },
	{ cmd: 'gdam add @user/addon[@tag]', does: 'Resolve it, install it, record its exact Release tag' },
	{ cmd: 'gdam install', does: 'Install every exact tag the manifest records' },
	{ cmd: 'gdam remove @user/addon', does: 'Take it out, and out of the manifest' },
	{ cmd: 'gdam link @user/addon [path]', does: 'Point it at a checkout on your disk' },
	{ cmd: 'gdam unlink @user/addon', does: 'Put the tagged release back' },
	{ cmd: 'gdam unlink --all', does: 'Undo every link at once' },
	{ cmd: 'gdam publish @user/addon TAG [ASSET_NAME]', does: 'Publish an exact Release tag and optional asset' },
	{ cmd: 'gdam --version', does: 'What is installed' },
];
---

<Full>
	<div class="folio">
		<header class="topbar">
			<a class="wordmark" href="/">
				GDAM
			</a>
			<nav aria-label="Main">
				<a href="#install">Install</a>
				<a href="https://app.gdam.dev">Registry ↗</a>
				<a href="https://github.com/aviorstudio/gdam">GitHub ↗</a>
			</nav>
		</header>
		<main id="main-content">
			<section class="package-cover">
				<div>
					<p class="tag">THE GODOT ADDON MANAGER</p>
					<h1>
						Godot addons.
						<br />
						<em>All in place.</em>
					</h1>
					<p>
						One manifest for the addons your project needs. Exact GitHub Release tags. A single command to put
						everything where it belongs.
					</p>
					<a class="cta" href={appUrl}>
						Explore the registry ↗
					</a>
					<p class="source-label">OPEN SOURCE / NO ACCOUNT TO INSTALL</p>
				</div>
				<div class="package-map">
					<div class="map-head">
						<span>YOUR PROJECT / DEPENDENCY MAP</span>
						<b>+</b>
					</div>
					<div class="manifest-node">
						<svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
							<path d="M8 3h11l7 7v19H8Z M19 3v8h7" fill="none" stroke="currentColor" stroke-width="1.5" />
						</svg>
						<div>
							<strong>gdam.json</strong>
							<span>Names + exact Release tags</span>
						</div>
					</div>
					<div class="map-connector">
						<span>↓</span>
						<code>gdam install</code>
						<span>↓</span>
					</div>
					<div class="addon-grid">
						<article>
							<span>01 / ADDON</span>
							<b>gd-router</b>
							<small>v0.0.2</small>
						</article>
						<article>
							<span>02 / ADDON</span>
							<b>gd-observe</b>
							<small>gd-v0.0.3</small>
						</article>
					</div>
					<div class="map-output">
						<span>DESTINATION</span>
						<code>res://addons/</code>
						<b>✓</b>
					</div>
				</div>
			</section>
			<section class="package-start" id="install">
				<div>
					<p class="tag">A SMALL TOOL. A TIDIER PROJECT.</p>
					<h2 class="section-heading">
						Start with
						<br />
						your first addon.
					</h2>
					<p>Install the CLI, create a manifest in your Godot project, then add an addon from the registry.</p>
					<a href={repo}>Installation guide ↗</a>
				</div>
				<div class="onboarding-terminal">
					<div class="terminal-bar">
						<span>GODOT PROJECT / QUICK START</span>
						<span>↗</span>
					</div>
					<pre><span>$ go install github.com/aviorstudio/gdam@v0.0.8</span>

$ gdam init
<span>created gdam.json</span>

$ gdam add @aviorstudio/gd-router
<span>installed @aviorstudio/gd-router@v0.0.2</span>

$ gdam install
<span>same manifest → same addon tags</span></pre>
					<div class="terminal-note">ILLUSTRATIVE SESSION · MIT · LINUX, MACOS & WINDOWS</div>
				</div>
			</section>
			<section class="card-grid">
				<article>
					<p class="tag">01 / PIN</p>
					<h3>Release tags stay explicit.</h3>
					<p>The manifest records exact, case-sensitive tags. Without a tag, GDAM selects the newest stable Release.</p>
				</article>
				<article>
					<p class="tag">02 / LINK</p>
					<h3>Room for local work.</h3>
					<p>
						Edit an addon next door. Its local path belongs in <code>gdam.link.json</code>, separate from the manifest
						you commit.
					</p>
				</article>
				<article>
					<p class="tag">03 / PUBLISH</p>
					<h3>Your releases stay yours.</h3>
					<p>The registry points to GitHub Release assets. Publishing uses an owner-scoped secret key.</p>
				</article>
			</section>
			<section class="repo-section" aria-label="What GDAM writes into your repository">
				<div class="section-head">
					<p class="eyebrow">
						<span></span> Two files, one job each
					</p>
					<h2>What ends up in your repo.</h2>
					<p>
						The session above wrote both of these. <code>gdam.json</code> is the one you commit: it records exact tags
						for <code>gd-observe</code> and <code>gd-router</code>, and lists
						<code>gd-gesture</code> with no tag because that addon is linked locally.
					</p>
					<p class="aside">
						Where that link actually points lives in <code>gdam.link.json</code> — an absolute path on one machine,
						which is exactly the kind of thing that must never reach anyone else's checkout. Keeping the two apart is
						the whole reason there are two.
					</p>
				</div>

				<div class="files">
					<div class="file">
						<div class="file-bar">
							<span class="icon" set:html={icon('file-code', 12)} /> gdam.json <i>commit this</i>
						</div>
						<pre>&#123;
  "addons": &#123;
    "@aviorstudio/gd-gesture": &#123;&#125;,
    "@aviorstudio/gd-observe": &#123;
      "tag": "gd-v0.0.3"
    &#125;,
    "@aviorstudio/gd-router": &#123;
      "tag": "v0.0.2"
    &#125;
  &#125;
&#125;</pre>
					</div>
					<div class="file">
						<div class="file-bar">
							<span class="icon" set:html={icon('file-code', 12)} /> gdam.link.json <i>yours alone</i>
						</div>
						<pre>&#123;
  "addons": &#123;
    "@aviorstudio/gd-gesture": &#123;
      "enabled": true,
      "path": "/home/you/code/roguelike/gd-gesture"
    &#125;
  &#125;
&#125;</pre>
					</div>
				</div>
			</section>
			<details class="reference">
				<summary>Commands, GitHub Actions and download integrity</summary>
				<section class="surface">
					<div class="section-head">
						<h2>The whole command surface.</h2>
						<p>
							Nine commands, and three environment variables behind them:
							<code>GDAM_API_URL</code> to point the CLI at another registry,
							<code>GDAM_SECRET_KEY</code> to publish from CI, and an optional
							<code>GITHUB_TOKEN</code> when release downloads start hitting GitHub's rate limit.
						</p>
						<p class="aside">
							Without a tag, GDAM resolves the newest stable (non-prerelease) Release. Exact tags may select prereleases
							and are case-sensitive: <code>Release-1</code> and
							<code>release-1</code> are different.
						</p>
						<pre class="yaml"><span class="key">- uses:</span> aviorstudio/gdam-actions/install@v0.1.0
  <span class="key">with:</span>
    <span class="key">version:</span> v0.0.8

<span class="key">- uses:</span> aviorstudio/gdam-actions/publish@v0.1.0
  <span class="key">with:</span>
    <span class="key">tag:</span> &#36;&#123;&#123; steps.release.outputs.tag &#125;&#125;
    <span class="key">asset:</span> &#36;&#123;&#123; steps.release.outputs.asset &#125;&#125;
    <span class="key">secret-key:</span> &#36;&#123;&#123; secrets.GDAM_SECRET_KEY &#125;&#125;</pre>
						<p class="aside pin-note">
							Exact release tags make the snippet readable and reproducible under the project's no-move policy, but Git
							tags can be moved or deleted. A Full 40-character commit SHA is the strongest GitHub Actions pin; use
							<code>15042aa1ff1e28f5e97828384b78a25c63d0199e</code> when immutability is required.
						</p>
						<p class="aside integrity">
							<strong>What v0.0.8 enforces.</strong> Registry requests time out after 30 seconds and responses are
							limited to 4 MiB. Asset downloads use the immutable asset-ID endpoint, time out after two minutes, follow
							at most five redirects, remove authorization on a cross-origin redirect, and stop at 128 MiB. GDAM checks
							the registered release, commit, asset identity and mandatory SHA-256 digest before extraction, and detects
							a truncated declared download. Extraction rejects absolute paths, <code>..</code> traversal, backslashes
							and symlinks, with at most 10,000 entries and 512 MiB total uncompressed content. The resulting package
							root must contain <code>plugin.cfg</code>.
						</p>
					</div>

					<table>
						<thead>
							<tr>
								<th scope="col">Command</th>
								<th scope="col">Does</th>
							</tr>
						</thead>
						<tbody>
							{commands.map((row) => (
								<tr>
									<th scope="row">
										<code>{row.cmd}</code>
									</th>
									<td>{row.does}</td>
								</tr>
							))}
						</tbody>
					</table>
				</section>
			</details>
			<section class="package-close">
				<p class="tag">PUT THE PIECES TOGETHER</p>
				<h2 class="section-heading">
					One file in.
					<br />
					The same addons out.
				</h2>
				<a class="cta" href={appUrl}>
					Find your next addon ↗
				</a>
				<a class="source-link" href={repo}>
					Read the CLI guide ↗
				</a>
			</section>
		</main>
		<footer class="bottom">
			<span>GDAM / by Avior Studio</span>
			<nav aria-label="Footer">
				<a href="https://github.com/aviorstudio/gdam">CLI</a>
				<a href="https://github.com/aviorstudio/gdam-actions">Actions</a>
				<a href="https://app.gdam.dev">Registry</a>
			</nav>
		</footer>
	</div>
</Full>
