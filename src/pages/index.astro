---
import Full from '../layouts/Full.astro';
import octicons from '@primer/octicons';

const appUrl = 'https://app.gdam.dev';
const repo = 'https://github.com/aviorstudio/gdam';
const actions = 'https://github.com/aviorstudio/gdam-actions';
const icon = (name: keyof typeof octicons, size = 16) =>
	octicons[name].toSVG({ width: size, height: size });

// Every command the CLI has, taken from printUsage in main.go. Listing all of
// them rather than the three that make a good demo is the point: this is the
// whole surface, and it is small enough to print.
const commands = [
	{ cmd: 'gdam init', does: 'Write gdam.json in this Godot project' },
	{ cmd: 'gdam add @user/addon[@tag]', does: 'Resolve it, install it, record its exact Release tag' },
	{ cmd: 'gdam install', does: 'Install every exact tag the manifest records' },
	{ cmd: 'gdam remove @user/addon', does: 'Take it out, and out of the manifest' },
	{ cmd: 'gdam link @user/addon [path]', does: 'Point it at a checkout on your disk' },
	{ cmd: 'gdam unlink @user/addon', does: 'Put the tagged release back' },
	{ cmd: 'gdam unlink --all', does: 'Undo every link at once' },
	{ cmd: 'gdam publish @user/addon TAG [ASSET_NAME]', does: 'Publish an exact Release tag and optional asset' },
	{ cmd: 'gdam --version', does: 'What is installed' },
];
---

<Full>
	<div class="page-shell">
		<header class="site-header">
			<a class="brand" href="/" aria-label="GDAM home">
				<svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
					<path d="M16 3 28 10v12L16 29 4 22V10L16 3Z"></path>
					<path d="M16 9v9m-4-4 4 4 4-4m-9 8h10"></path>
				</svg>
				<span>GDAM</span>
			</a>
			<a class="header-cta" href={appUrl}>Browse the registry <span class="icon" set:html={icon('arrow-up-right', 14)} /></a>
		</header>

		<main>
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow"><span></span> Godot Addon Manager</p>
					<h1>Godot addons, <em>pinned.</em></h1>
					<p class="lede">
						One manifest lists what your project uses, and <code>gdam install</code> puts those exact,
						case-sensitive GitHub Release tags under <code>res://addons/</code>. Installing needs no
						account.
					</p>
					<div class="hero-actions">
						<code class="install">go install github.com/aviorstudio/gdam@v0.0.8</code>
						<p>MIT · one static binary · Linux, macOS and Windows</p>
					</div>
				</div>

				<div class="product-frame" aria-label="a gdam session in a Godot project">
					<div class="frame-bar">
						<div class="frame-brand"><span class="menu-lines"></span> roguelike / godot_client</div>
						<div class="frame-actions"><span class="icon" set:html={icon('package', 13)} /><span class="icon" set:html={icon('terminal', 13)} /></div>
					</div>
					<div class="term">
						<pre><span class="cmd">$ gdam init</span>
created ~/code/roguelike/godot_client/gdam.json

<span class="cmd">$ gdam add @aviorstudio/gd-router</span>
installed @aviorstudio/gd-router@v0.0.2

<span class="cmd">$ gdam add @aviorstudio/gd-observe</span>
installed @aviorstudio/gd-observe@gd-v0.0.3

<span class="cmd">$ gdam link @aviorstudio/gd-gesture ../gd-gesture</span>
linked @aviorstudio/gd-gesture -&gt; ~/code/roguelike/gd-gesture

<span class="cmd">$ gdam install</span>
installed @aviorstudio/gd-observe@gd-v0.0.3
installed @aviorstudio/gd-router@v0.0.2
<span class="cursor"></span></pre>
					</div>
					<div class="frame-keys"><span>3 addons</span> two pinned, one linked<i></i><span>0 accounts</span> reads are public</div>
				</div>
			</section>

			<section class="principles" aria-label="How GDAM works">
				<article>
					<span class="number">01</span>
					<div>
						<h2>The manifest you ship never learns about your disk</h2>
						<p>
							<code>gdam.json</code> holds addon names and exact Release tags and nothing else. A local
							checkout is recorded in a separate <code>gdam.link.json</code>, so you can build
							against an addon you are editing without the file your teammates install from
							changing at all.
						</p>
					</div>
				</article>
				<article>
					<span class="number">02</span>
					<div>
						<h2>The registry stores a pointer, not your code</h2>
						<p>
							Publishing records one exact, case-sensitive GitHub Release tag and an asset in it —
							there is no separate semantic package version. The extracted package root must include
							<code>plugin.cfg</code>, and GDAM
							unpacks it into <code>res://addons/@owner_repo/</code> whatever the asset was called.
							Your releases stay yours.
						</p>
					</div>
				</article>
				<article>
					<span class="number">03</span>
					<div>
						<h2>Installing needs no account</h2>
						<p>
							Reads are public and anonymous, and the CLI carries no credentials — which is why
							there is nothing to log into before <code>gdam install</code> works in CI. Publishing
							uses a secret key scoped to one user or org, and it can only cut releases for addons
							already under that owner.
						</p>
					</div>
				</article>
			</section>

			<section class="repo-section" aria-label="What GDAM writes into your repository">
				<div class="section-head">
					<p class="eyebrow"><span></span> Two files, one job each</p>
					<h2>What ends up in your repo.</h2>
					<p>
						The session above wrote both of these. <code>gdam.json</code> is the one you commit: it
						records exact tags for <code>gd-observe</code> and <code>gd-router</code>, and lists
						<code>gd-gesture</code> with no tag because that addon is linked locally.
					</p>
					<p class="aside">
						Where that link actually points lives in <code>gdam.link.json</code> — an absolute path
						on one machine, which is exactly the kind of thing that must never reach anyone else's
						checkout. Keeping the two apart is the whole reason there are two.
					</p>
				</div>

				<div class="files">
					<div class="file">
						<div class="file-bar"><span class="icon" set:html={icon('file-code', 12)} /> gdam.json <i>commit this</i></div>
						<pre>&#123;
  "addons": &#123;
    "@aviorstudio/gd-gesture": &#123;&#125;,
    "@aviorstudio/gd-observe": &#123;
      "tag": "gd-v0.0.3"
    &#125;,
    "@aviorstudio/gd-router": &#123;
      "tag": "v0.0.2"
    &#125;
  &#125;
&#125;</pre>
					</div>
					<div class="file">
						<div class="file-bar"><span class="icon" set:html={icon('file-code', 12)} /> gdam.link.json <i>yours alone</i></div>
						<pre>&#123;
  "addons": &#123;
    "@aviorstudio/gd-gesture": &#123;
      "enabled": true,
      "path": "/home/you/code/roguelike/gd-gesture"
    &#125;
  &#125;
&#125;</pre>
					</div>
				</div>
			</section>

			<section class="surface">
				<div class="section-head">
					<h2>The whole command surface.</h2>
					<p>
						Nine commands, and three environment variables behind them:
						<code>GDAM_API_URL</code> to point the CLI at another registry,
						<code>GDAM_SECRET_KEY</code> to publish from CI, and an optional
						<code>GITHUB_TOKEN</code> when release downloads start hitting GitHub's rate limit.
					</p>
					<p class="aside">
						Without a tag, GDAM resolves the newest stable (non-prerelease) Release. Exact tags may
						select prereleases and are case-sensitive: <code>Release-1</code> and
						<code>release-1</code> are different.
					</p>
					<pre class="yaml"><span class="key">- uses:</span> aviorstudio/gdam-actions/install@v0.0.2
  <span class="key">with:</span>
    <span class="key">version:</span> v0.0.8

<span class="key">- uses:</span> aviorstudio/gdam-actions/publish@v0.0.2
  <span class="key">with:</span>
    <span class="key">tag:</span> &#36;&#123;&#123; steps.release.outputs.tag &#125;&#125;
    <span class="key">asset:</span> &#36;&#123;&#123; steps.release.outputs.asset &#125;&#125;
    <span class="key">secret-key:</span> &#36;&#123;&#123; secrets.GDAM_SECRET_KEY &#125;&#125;</pre>
					<p class="aside pin-note">
						Exact release tags make the snippet readable and reproducible under the project's
						no-move policy, but Git tags can be moved or deleted. A Full 40-character commit SHA is
						the strongest GitHub Actions pin; use
						<code>d735444eb470194585def44521d5d91df2260e63</code> when immutability is required.
					</p>
					<p class="aside integrity">
						<strong>What v0.0.8 enforces.</strong> Registry requests time out after 30 seconds and
						responses are limited to 4 MiB. Asset downloads use the immutable asset-ID endpoint,
						time out after two minutes, follow at most five redirects, remove authorization on a
						cross-origin redirect, and stop at 128 MiB. GDAM checks the registered release, commit,
						asset identity and mandatory SHA-256 digest before extraction, and detects a truncated
						declared download. Extraction rejects absolute paths, <code>..</code> traversal,
						backslashes and symlinks, with at most 10,000 entries and 512 MiB total uncompressed
						content. The resulting package root must contain <code>plugin.cfg</code>.
					</p>
				</div>

				<table>
					<thead>
						<tr><th scope="col">Command</th><th scope="col">Does</th></tr>
					</thead>
					<tbody>
						{
							commands.map((row) => (
								<tr>
									<th scope="row"><code>{row.cmd}</code></th>
									<td>{row.does}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</section>

			<section class="closing">
				<p>One file in.<br />The same addons out.</p>
				<div><span>GDAM.JSON</span><i></i><span>GITHUB RELEASE</span><i></i><span>RES://ADDONS/</span></div>
				<div class="install-routes">
					<div>
						<p>macOS and Linux</p>
						<code>curl -fsSL https://raw.githubusercontent.com/aviorstudio/gdam/main/scripts/install_cli.sh | VERSION=v0.0.8 sh</code>
					</div>
					<div>
						<p>With the Go toolchain</p>
						<code>go install github.com/aviorstudio/gdam@v0.0.8</code>
					</div>
				</div>
				<div class="closing-actions">
					<a class="primary-cta light" href={appUrl}>Browse the registry <span class="icon" set:html={icon('arrow-right', 16)} /></a>
					<a class="ghost-cta" href={repo}>Source on GitHub <span class="icon" set:html={icon('arrow-up-right', 14)} /></a>
				</div>
			</section>
		</main>

		<footer>
			<a class="brand footer-brand" href="/"><span>GDAM</span></a>
			<p><a href={repo}>cli</a> · <a href={actions}>actions</a> · <a href={appUrl}>registry</a> · MIT</p>
			<p>© {new Date().getFullYear()} Avior Studio</p>
		</footer>
	</div>
</Full>

<style>
	.page-shell { min-height: 100svh; overflow-x: hidden; }
	.site-header { width: min(1180px, calc(100% - 40px)); height: 76px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
	.brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-size: 19px; font-weight: 760; letter-spacing: -.03em; text-decoration: none; }
	.brand-mark { width: 27px; height: 27px; }
	.brand-mark path:first-child { fill: var(--ink); stroke: none; }
	.brand-mark path:last-child { fill: none; stroke: #7dd3fc; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
	.header-cta { display: inline-flex; align-items: center; color: var(--ink); border-bottom: 1px solid #c2cbd6; padding: 6px 0; font-size: 13px; font-weight: 650; text-decoration: none; white-space: nowrap; }
	.header-cta span { margin-left: 5px; color: var(--sky-deep); }
	:global(.icon svg) { display: block; fill: currentColor; }

	.hero { width: min(1180px, calc(100% - 40px)); margin: 70px auto 110px; display: grid; grid-template-columns: .95fr 1.05fr; align-items: center; gap: 64px; }
	.hero-copy { position: relative; z-index: 2; }
	.eyebrow { display: flex; align-items: center; gap: 9px; margin: 0 0 22px; color: var(--quiet); font: 620 11px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
	.eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: var(--sky); box-shadow: 0 0 0 4px rgba(2, 132, 199, .14); }
	/* Capped below the family's 78px so "Godot addons," stays on one line: it is
	   a single phrase, and breaking it after "Godot" reads as two. */
	h1 { max-width: 600px; margin: 0; color: var(--ink); font-size: clamp(46px, 5.2vw, 70px); font-weight: 590; line-height: .98; letter-spacing: -.062em; }
	h1 em { color: var(--sky-deep); font-family: Georgia, 'Times New Roman', serif; font-weight: 400; }
	.lede { max-width: 520px; margin: 30px 0 32px; color: var(--quiet); font-size: 16px; line-height: 1.7; }
	.lede code { border-radius: 3px; background: #e2e8f0; padding: 1px 5px; color: #3d4b60; font: 13px var(--mono); }
	.hero-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
	.install { display: block; max-width: 100%; overflow-x: auto; border: 1px solid var(--line); border-radius: 5px; background: white; padding: 13px 16px; color: var(--ink); font: 500 12.5px/1 var(--mono); white-space: nowrap; }
	.hero-actions p { margin: 0; color: #7a879a; font: 500 10px/1.4 var(--mono); text-transform: uppercase; letter-spacing: .05em; }

	/* The session, as it runs. Text rather than a screenshot: it stays
	   selectable, it scales with the reader's font, and it cannot go blurry on
	   a display it was not captured for. gdam emits no ANSI codes at all, so
	   the only colour in here is the prompt -- see README. */
	.product-frame { position: relative; min-width: 640px; border: 1px solid var(--line); border-radius: 9px; background: white; box-shadow: 0 35px 80px rgba(15, 23, 43, .13), 0 3px 10px rgba(15, 23, 43, .06); overflow: hidden; transform: perspective(1400px) rotateY(-3deg) rotateX(1deg); }
	.product-frame::before { content: ''; position: absolute; z-index: -1; width: 340px; height: 340px; right: -70px; top: -90px; border-radius: 50%; background: var(--sky); filter: blur(80px); opacity: .26; }
	.frame-bar { height: 42px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #e6ebf1; padding: 0 13px; color: #4f5c70; font: 600 10px var(--mono); }
	.frame-brand, .frame-actions { display: flex; align-items: center; gap: 11px; }
	.menu-lines { width: 13px; height: 8px; border-block: 1px solid #737f92; position: relative; }
	.menu-lines::after { content: ''; position: absolute; left: 0; right: 0; top: 3px; border-top: 1px solid #737f92; }
	.frame-actions span { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 4px; background: #eef2f7; color: #404c5e; }

	.term { background: #0b1220; padding: 18px 20px; overflow-x: auto; }
	.term pre { width: max-content; margin: 0; color: #cbd5e1; font: 11.5px/1.75 var(--mono); }
	.term .cmd { color: #7dd3fc; }
	.cursor { display: inline-block; width: 6px; height: 12px; margin-left: 4px; background: #7dd3fc; vertical-align: middle; animation: blink 1.2s step-end infinite; }
	.frame-keys { height: 34px; display: flex; align-items: center; gap: 9px; border-top: 1px solid #1a2434; background: #0b1220; padding: 0 20px; color: #64748b; font: 9.5px var(--mono); white-space: nowrap; overflow-x: auto; }
	.frame-keys span { flex: none; color: #7dd3fc; font-weight: 500; }
	.frame-keys i { flex: none; width: 3px; height: 3px; border-radius: 50%; background: #334155; }

	.principles { width: min(1180px, calc(100% - 40px)); margin: 0 auto 110px; border-top: 1px solid var(--line); }
	.principles article { display: grid; grid-template-columns: 90px 1fr; border-bottom: 1px solid var(--line); padding: 32px 0; }
	.principles article div { display: grid; grid-template-columns: .75fr 1fr; align-items: baseline; gap: 40px; }
	.number { color: var(--sky-deep); font: 650 10px var(--mono); }
	.principles h2 { max-width: 300px; margin: 0; color: var(--ink); font-size: 22px; font-weight: 580; letter-spacing: -.035em; }
	.principles p { max-width: 560px; margin: 0; color: var(--quiet); font-size: 14px; line-height: 1.65; }
	.principles code, .section-head code { border-radius: 3px; background: #e2e8f0; padding: 1px 5px; font: 12px var(--mono); }

	.section-head h2 { margin: 0 0 22px; color: var(--ink); font-size: clamp(30px, 3.8vw, 44px); font-weight: 560; line-height: 1.02; letter-spacing: -.05em; }
	.section-head p { margin: 0 0 14px; color: var(--quiet); font-size: 15px; line-height: 1.7; }
	.section-head .aside { color: #79879b; font-size: 13.5px; }

	.repo-section { width: min(1180px, calc(100% - 40px)); margin: 0 auto 110px; display: grid; grid-template-columns: .82fr 1.18fr; align-items: start; gap: 60px; }
	.repo-section .section-head p { max-width: 460px; }
	/* Stacked, not side by side. Halving the width truncates the one line that
	   matters most -- the absolute path in gdam.link.json, which is the whole
	   reason the second file exists -- and a value cut off mid-string reads as
	   a broken panel rather than as a long path. */
	.files { display: grid; grid-template-columns: 1fr; gap: 18px; }
	.file { border: 1px solid var(--line); border-radius: 9px; background: white; overflow: hidden; box-shadow: 0 12px 30px rgba(15, 23, 43, .07); }
	.file-bar { display: flex; align-items: center; gap: 8px; border-bottom: 1px solid #e6ebf1; padding: 10px 13px; color: #4f5c70; font: 600 10px var(--mono); }
	.file-bar i { margin-left: auto; color: #94a3b8; font-style: normal; font-weight: 500; }
	.file pre { margin: 0; padding: 16px 18px; overflow-x: auto; color: #3d4b60; font: 11px/1.7 var(--mono); }

	.surface { width: min(1180px, calc(100% - 40px)); margin: 0 auto 110px; display: grid; grid-template-columns: .82fr 1.18fr; align-items: start; gap: 60px; }
	.surface .section-head p { max-width: 460px; }
	.yaml { margin: 26px 0 0; border: 1px solid var(--line); border-radius: 7px; background: white; padding: 16px 18px; overflow-x: auto; color: #3d4b60; font: 11px/1.75 var(--mono); }
	.yaml .key { color: var(--sky-deep); }
	.surface table { width: 100%; border-collapse: collapse; }
	.surface th, .surface td { text-align: left; border-bottom: 1px solid var(--line); padding: 13px 12px 13px 0; font-size: 13px; font-weight: 500; vertical-align: baseline; }
	.surface thead th { color: var(--quiet); font: 650 9px var(--mono); letter-spacing: .09em; text-transform: uppercase; padding-bottom: 10px; }
	.surface tbody th code { color: var(--ink); font: 600 12px var(--mono); white-space: nowrap; }
	.surface tbody td { color: var(--quiet); }

	.closing { width: min(1180px, calc(100% - 40px)); margin: 0 auto; border-radius: 8px; background: var(--ink); color: white; padding: 65px; }
	.closing > p { max-width: 680px; margin: 0 0 45px; font-size: clamp(40px, 5.6vw, 68px); font-weight: 530; line-height: .99; letter-spacing: -.055em; }
	.closing > div:first-of-type { display: flex; align-items: center; gap: 13px; margin-bottom: 40px; color: #8fa0b8; font: 560 9px var(--mono); letter-spacing: .09em; }
	.closing > div:first-of-type i { width: 50px; border-top: 1px dashed #44536b; }
	.install-routes { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-bottom: 38px; }
	.install-routes p { margin: 0 0 9px; color: #8fa0b8; font: 500 9px var(--mono); letter-spacing: .08em; text-transform: uppercase; }
	.install-routes code { display: block; overflow-x: auto; border: 1px solid #26344a; border-radius: 5px; background: #0b1220; padding: 12px 14px; color: #dbe4ef; font: 500 11.5px/1 var(--mono); white-space: nowrap; }
	.closing-actions { display: flex; align-items: center; gap: 22px; }
	.primary-cta { display: inline-flex; align-items: center; gap: 30px; border-radius: 4px; background: var(--ink); color: white; padding: 14px 18px; font-size: 13px; font-weight: 680; text-decoration: none; transition: transform .18s ease, background .18s ease; }
	.primary-cta:hover { transform: translateY(-2px); }
	.primary-cta.light { background: #7dd3fc; color: #082133; }
	.primary-cta.light span { color: #082133; }
	.ghost-cta { display: inline-flex; align-items: center; color: #c3cedd; border-bottom: 1px solid #38455a; padding: 6px 0; font-size: 13px; font-weight: 650; text-decoration: none; }
	.ghost-cta span { margin-left: 5px; color: #7dd3fc; }

	footer { width: min(1180px, calc(100% - 40px)); min-height: 120px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr 1fr; align-items: center; color: #7a879a; font: 500 10px var(--mono); }
	footer p { margin: 0; }
	footer p:nth-child(2) { text-align: center; }
	footer p:last-child { text-align: right; }
	footer a { color: #7a879a; text-decoration: none; border-bottom: 1px solid #cbd4de; }
	footer a:hover { color: var(--ink); }
	footer a.footer-brand { justify-self: start; border: 0; color: var(--ink); font-family: var(--sans); font-size: 16px; }

	@keyframes blink { 50% { opacity: 0; } }

	@media (max-width: 980px) {
		.hero { grid-template-columns: 1fr; margin-top: 45px; gap: 55px; }
		.hero-copy { max-width: 680px; }
		.product-frame { min-width: 0; width: 100%; transform: none; }
		.principles article div { grid-template-columns: 1fr; gap: 9px; }
		.principles h2 { max-width: none; }
		.repo-section, .surface { grid-template-columns: 1fr; gap: 34px; }
		.repo-section .section-head p, .surface .section-head p { max-width: 680px; }
	}
	@media (max-width: 600px) {
		.site-header, .hero, .principles, .repo-section, .surface, .closing, footer { width: min(100% - 28px, 1180px); }
		.site-header { height: 64px; gap: 12px; }
		.header-cta { font-size: 12px; }
		.hero { margin: 46px auto 80px; }
		.eyebrow { margin-bottom: 18px; }
		h1 { font-size: clamp(44px, 14vw, 62px); }
		.lede { margin-top: 24px; font-size: 15px; }
		.install { font-size: 10.5px; padding: 11px 13px; }
		.product-frame { border-radius: 6px; }
		.term { padding: 14px; }
		.term pre { font-size: 9px; line-height: 1.8; }
